# ==========================================================================
# Kitchen-sink Promptfile — showcases ALL features in one file
#
# This is a reference, not a starting point. See examples/ for simpler,
# realistic Promptfiles you can copy and adapt.
#
# Usage:
#   makethlm --list                     # list tasks, functions, hosts, llms
#   makethlm --dry-run build            # preview what would run
#   makethlm deploy staging             # deploy with args
# ==========================================================================

# --------------------------------------------------------------------------
# Settings
# --------------------------------------------------------------------------

set dotenv-load
set shell "/bin/bash"
set export
set ignore-comments

project := "my-web-app"
env := "staging"
export API_URL := "https://api.example.com"
tag := "v" + "1" + ".0"
deploy_msg := if env == "staging" { "deploying to staging" } else { "deploying to prod" }

# --------------------------------------------------------------------------
# LLM Providers — select globally, override per-task
# --------------------------------------------------------------------------

llm claude [model=opus]
llm openai [model=gpt-4, key=$OPENAI_API_KEY]
llm ollama [model=llama3, base_url=http://localhost:11434]

# --------------------------------------------------------------------------
# Host Inventory — Ansible-like, tasks run via SSH
# --------------------------------------------------------------------------

hosts web [user=deploy]:
    web1.prod.internal
    web2.prod.internal
    web3.prod.internal

hosts db [user=postgres, port=5433]:
    db-primary.prod.internal
    db-replica.prod.internal

# --------------------------------------------------------------------------
# Functions — reusable prompt templates, referenced with @use
# --------------------------------------------------------------------------

fn security_review:
    Review the code for security vulnerabilities.
    Check specifically for:
    - SQL injection
    - XSS (cross-site scripting)
    - Command injection
    - Path traversal
    Be concise and actionable.

fn code_quality:
    Check for code quality issues:
    - Functions longer than 50 lines
    - Duplicated logic
    - Missing error handling
    - Poor naming

# --------------------------------------------------------------------------
# Tasks — shell commands (!) interleaved with LLM prompts
# --------------------------------------------------------------------------

# Build: mix shell prep with an LLM check
task build:
    !mkdir -p dist
    check if moo.md is newer than the Dockerfile.
    if so, rebuild the docker image from scratch.
    tag it as {{project}}:latest.

# Run tests with shell, then ask LLM to analyze failures
task test: build:
    !@silent npm install
    !npm test
    if any tests failed, explain the root cause and suggest a fix.

# Security review — uses opus for thoroughness
task review [llm=claude, model=opus, temperature=0.1]:
    @use security_review
    Focus on the git diff for {{project}}.
    !git diff --stat

# Fast code quality check — uses a cheaper model
task lint [llm=openai]:
    @use code_quality
    Apply to the src/ directory of {{project}}.

# Deploy with arguments, runs on web hosts via SSH
task deploy(target, port="8080"): build test [llm=openai, on=web]:
    !systemctl restart {{project}}
    verify {{project}} is running on {{target}} port {{port}}.
    @use security_review

# Database backup — runs on db hosts
task backup [on=db]:
    !pg_dump {{project}} > /tmp/{{project}}-backup.sql
    !@silent gzip /tmp/{{project}}-backup.sql
    verify the backup completed successfully.

# Clean up with silent + ignore-error shell commands
task clean [doc=Remove build artifacts, group=maintenance]:
    !@silent rm -rf dist/
    !@silent @ignore docker rmi {{project}}:latest
    cleaned up build artifacts.

# Private task — hidden from --list
task _internal [private]:
    internal maintenance routine.

# Dangerous deploy requires confirmation
task prod-deploy(target): build test [confirm=Really deploy to production?, linux]:
    deploy {{project}} to {{target}} in production mode.
    running on {{os()}} / {{arch()}}

# Greet multiple people (variadic argument)
task greet(+names):
    say hello to {{names}}, you're on {{os()}} with {{num_cpus()}} cpus

# Linux-only task using bare OS attribute
task systemd-check [linux, no-exit-message]:
    !systemctl status myapp
    verify the service is healthy

# Security gate for contributors and agents before committing code changes
task pre-commit-security-review [doc=Review staged changes for security before committing, group=security]:
    !git diff --check
    !git diff --cached --check
    !bash -lc 'if git grep -n -I -E "(AKIA[0-9A-Z]{16}|-----BEGIN (RSA|OPENSSH|EC|DSA) PRIVATE KEY-----|ghp_[A-Za-z0-9_]{30,}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9]{20,})" -- . ":!dist" ":!site"; then echo "Potential secret pattern found" >&2; exit 1; fi'
    Review the staged diff from a security perspective.
    Focus on secret leakage, unsafe subprocess usage, path traversal,
    shell/SSH/Docker execution, webhook payloads, safe mode bypasses,
    and redaction regressions.
    !git diff --cached --stat

# --------------------------------------------------------------------------
# Aliases — short names for common tasks
# --------------------------------------------------------------------------

alias b := build
alias t := test
alias d := deploy

# --------------------------------------------------------------------------
# Docker — describe the image, LLM generates the Dockerfile, then builds
# --------------------------------------------------------------------------

docker api-server [tag=latest]:
    A Python 3.11 slim image.
    Install requirements.txt with pip, no cache.
    Copy the app/ directory to /app.
    Set the working directory to /app.
    Expose port 8080.
    Run with gunicorn, 4 workers, binding 0.0.0.0:8080.
